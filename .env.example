# ==============================================================================
# SatQuery: Production Environment Configuration
# ==============================================================================

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database & Cache (Optional - in-memory fallback enabled)
DATABASE_URL=postgresql://satquery:satquery_secret@localhost:5432/satquery_db
REDIS_URL=redis://localhost:6379/0

# Google Earth Engine (Optional - high-fidelity scientific mock engine runs if omitted)
GEE_PROJECT_ID=satquery-cloud
GEE_SERVICE_ACCOUNT=satquery-runner@satquery-cloud.iam.gserviceaccount.com
GEE_KEY_FILE=
GEE_PRIVATE_KEY_JSON_BASE64=

# AI & LLM Intelligence ("The Why Engine")
# If omitted, intelligent empirical attribution fallback provides instant analysis
GEMINI_API_KEY="AIzaSyBv1hkbq1Yp7TdIllWLUPFkWlNVNpmkVpA"
GEMINI_MODEL=gemini-2.5-flash

# Secondary Geospatial APIs
NASA_FIRMS_MAP_KEY=your_nasa_firms_key_here
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=
